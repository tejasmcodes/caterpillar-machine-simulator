# Unique machine identifier (EXC001 / EXC002 / EXC003)
MACHINE_ID=EXC001

# MQTT broker
MQTT_BROKER_URL=mqtt://localhost:1883

# Default scenario (NORMAL, SEATBELT_VIOLATION, EXCESSIVE_IDLE, OVERHEATING,
# HIGH_VIBRATION, PROXIMITY_HAZARD, ABNORMAL_FUEL_CONSUMPTION, SENSOR_FAULT,
# ROLLOVER_RISK, IMPACT, WORKER_NEARBY, OPERATOR_ABSENT, LOW_OIL_PRESSURE, OVERLOAD)
SCENARIO=NORMAL

# Publishing intervals
SIMULATOR_INTERVAL_MS=4000
HEARTBEAT_INTERVAL_MS=5000
SITE_CONDITIONS_INTERVAL_MS=60000

# Control page / API port (use 3001, 3002... for extra machines on one laptop)
CONTROL_PORT=3000

# Site conditions sent on site/conditions (also changeable from the control page)
SITE_WEATHER=CLEAR
SITE_VISIBILITY=GOOD
SITE_AMBIENT_TEMP_C=31

# Starting machine location
MACHINE_LATITUDE=12.970000
MACHINE_LONGITUDE=79.156000
